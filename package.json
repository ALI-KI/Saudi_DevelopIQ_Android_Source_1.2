{
  "name": "saudi-developiq-riyadh",
  "version": "1.2.0",
  "description": "Saudi DevelopIQ – Android Edition. Offline real-estate development feasibility tool.",
  "main": "dist-electron/main/main.js",
  "author": "Mahmoud Elgamsy",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run --config vitest.config.ts",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "mobile:dev": "vite --host 0.0.0.0",
    "mobile:build": "vite build",
    "mobile:check": "node scripts/mobile-check.mjs",
    "mobile:sync": "npm run mobile:build && npx cap sync android",
    "mobile:apk": "npm run mobile:build && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "chart.js": "^4.4.3",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "recharts": "^2.15.1",
    "sql.js": "^1.12.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3",
    "@capacitor/core": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/app": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "concurrently": "^9.1.2",
    "electron": "^34.1.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.20.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wait-on": "^8.0.2",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/assets": "^3.0.0"
  },
  "build": {
    "appId": "com.mobd3on.saudidevelopiq",
    "productName": "Saudi DevelopIQ",
    "executableName": "SaudiDevelopIQ",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/data",
        "to": "data"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Saudi DevelopIQ Setup.exe",
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Saudi DevelopIQ"
    }
  }
}
